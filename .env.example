   # Plantilla de configuración. Copiá este archivo como ".env" y completá los valores.
   APP_NAME=Nombre de la tienda
   APP_EMAIL=correo@ejemplo.com
   APP_ENV=local

   # Conexión a la base de datos (completar con los datos de tu servidor local)
   DB_HOST=127.0.0.1
   DB_PORT=3306
   DB_NAME=nombre_de_la_base
   DB_USER=usuario_de_la_base
   DB_PASS=